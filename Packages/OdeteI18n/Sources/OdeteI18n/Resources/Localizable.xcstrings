          "stringUnit": {
            "state": "translated",
            "value": "Un archivo SwiftUI. El Preview muestra la view al instante; para ejecutarla de verdad, crea un paquete de app."
          }
        }
      }
    },
    "Um repositório guarda cada passo e deixa desfazer sem medo.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A repository keeps every step and lets you undo without fear."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Repository hält jeden Schritt fest und lässt dich angstfrei widerrufen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un dépôt garde chaque étape et permet d’annuler sans crainte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un repositorio guarda cada paso y deja deshacer sin miedo."
          }
        }
      }
    },
