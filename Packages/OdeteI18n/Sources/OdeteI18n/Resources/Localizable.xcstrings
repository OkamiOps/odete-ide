          "stringUnit": {
            "state": "translated",
            "value": "In full screen the iPad suspends Odete and the page stops responding within seconds. Drag Safari to the side (Split View) and the server keeps serving while you test."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Vollbild setzt das iPad Odete aus, und die Seite reagiert nach wenigen Sekunden nicht mehr. Ziehen Sie Safari zur Seite (Split View), dann liefert der Server weiter, während Sie testen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En plein écran, l’iPad suspend Odete et la page cesse de répondre en quelques secondes. Faites glisser Safari sur le côté (Split View) et le serveur continue de répondre pendant vos tests."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En pantalla completa el iPad suspende Odete y la página deja de responder en pocos segundos. Arrastra Safari a un lado (Split View) y el servidor sigue sirviendo mientras pruebas."
          }
        }
      }
    },
