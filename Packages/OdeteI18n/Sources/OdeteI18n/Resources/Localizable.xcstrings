    "\n… (ainda rodando após 5 min)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\n… (still running after 5 min)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "\n… (läuft nach 5 min noch)"
          }
