        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: TypeScript %2$@ es el compilador nativo (Go) y no funciona en el iPad. Para comprobar tipos aquí, instala el compilador en JavaScript: npm i -D typescript@6"
