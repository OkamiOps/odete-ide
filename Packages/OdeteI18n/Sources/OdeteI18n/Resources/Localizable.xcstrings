          "stringUnit": {
            "state": "translated",
            "value": "%1$@: TypeScript %2$@ ist der native Compiler (Go) und läuft nicht auf dem iPad. Für die Typprüfung hier den JavaScript-Compiler installieren: npm i -D typescript@6"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ : TypeScript %2$@ est le compilateur natif (Go) et ne fonctionne pas sur iPad. Pour vérifier les types ici, installe le compilateur JavaScript : npm i -D typescript@6"
