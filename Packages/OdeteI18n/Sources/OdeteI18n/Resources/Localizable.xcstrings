    "Uma IDE que roda inteira no iPad: arquivos, git, terminal, preview e um agente que edita o projeto. Sem Mac, sem servidor.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An IDE that runs entirely on the iPad: files, git, terminal, preview and an agent that edits the project. No Mac, no server."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine IDE, die ganz auf dem iPad läuft: Dateien, git, Terminal, Preview und ein Agent, der das Projekt bearbeitet. Kein Mac, kein Server."
          }
        },
        "fr": {
          "stringUnit": {
