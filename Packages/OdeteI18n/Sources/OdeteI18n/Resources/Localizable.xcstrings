    "A conta recusou um parâmetro do pedido. Troque o modelo ou baixe o esforço.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The account rejected a request parameter. Switch the model or lower the effort."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Konto hat einen Parameter der Anfrage abgelehnt. Wechsle das Modell oder senke den Aufwand."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le compte a refusé un paramètre de la requête. Change de modèle ou baisse l’effort."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cuenta rechazó un parámetro de la solicitud. Cambia el modelo o baja el esfuerzo."
          }
        }
      }
    },
    "A conversa passou da janela de %1$@ fichas do modelo. Comece uma conversa nova.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The conversation outgrew the model's %1$@-token window. Start a new one."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
