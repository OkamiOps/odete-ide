          }
        }
      }
    },
    "Uma conta conectada libera push, clone de repositório privado e os pull requests dentro da Odete. O token fica no Keychain do iPad.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A connected account unlocks push, cloning private repositories and pull requests inside Odete. The token stays in the iPad's Keychain."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein verbundenes Konto schaltet push, clone privater Repositorys und die pull requests in Odete frei. Das Token bleibt im Keychain des iPads."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un compte connecté débloque le push, le clone de dépôt privé et les pull requests dans Odete. Le token reste dans le Keychain de l’iPad."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una cuenta conectada habilita el push, el clone de repositorio privado y los pull requests dentro de Odete. El token se queda en el Keychain del iPad."
          }
        }
      }
    },
