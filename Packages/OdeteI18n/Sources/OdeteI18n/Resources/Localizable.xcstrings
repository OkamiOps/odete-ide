    "  kill all para derrubar antes de subir outro": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "  kill all to shut it down before starting another"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "  kill all, um alles zu beenden, bevor du neu startest"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "  kill all pour tout arrêter avant d’en lancer un autre"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "  kill all para bajarlo antes de levantar otro"
          }
        }
      }
    },
