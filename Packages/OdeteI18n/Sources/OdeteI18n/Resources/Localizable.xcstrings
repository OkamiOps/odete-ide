    "# %1$@\n\nCriado na Odete, direto no iPad.\n\n%2$@\n": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "# %1$@\n\nMade in Odete, right on the iPad.\n\n%2$@\n"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "# %1$@\n\nIn Odete erstellt, direkt auf dem iPad.\n\n%2$@\n"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "# %1$@\n\nCréé dans Odete, directement sur l’iPad.\n\n%2$@\n"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "# %1$@\n\nCreado en Odete, directo en el iPad.\n\n%2$@\n"
          }
        }
      }
    },
    "%1$@\n\nPrimeiro passo: chame read_file no arquivo que precisa mudar, ou list_dir se não souber qual. Não explique antes de chamar.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@\n\nFirst step: call read_file on the file that needs to change, or list_dir if you don't know which. Do not explain before calling."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@\n\nErster Schritt: ruf read_file für die Datei auf, die sich ändern muss, oder list_dir, wenn du nicht weißt welche. Erklär nichts vorher."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@\n\nPremière étape : appelle read_file sur le fichier à modifier, ou list_dir si tu ne sais pas lequel. N'explique pas avant d'appeler."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@\n\nPrimer paso: llama a read_file en el archivo que hay que cambiar, o list_dir si no sabes cuál. No expliques antes de llamar."
          }
        }
      }
    },
