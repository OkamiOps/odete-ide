        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "\n… (tourne encore après 5 min)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\n… (todavía corriendo después de 5 min)"
          }
        }
      }
    },
