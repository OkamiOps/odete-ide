    "Vale por cima do tema escolhido. O que você não trocar continua vindo do tema, então trocar de tema depois ainda muda o resto.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This sits on top of the chosen theme. What you don’t change still comes from the theme, so switching themes later still changes the rest."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies liegt über dem gewählten Thema. Was Sie nicht ändern, kommt weiterhin vom Thema — ein späterer Themenwechsel ändert also weiterhin den Rest."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceci se superpose au thème choisi. Ce que vous ne changez pas vient toujours du thème : changer de thème plus tard modifie donc encore le reste."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto va por encima del tema elegido. Lo que no cambies sigue viniendo del tema, así que cambiar de tema después sigue cambiando lo demás."
          }
        }
      }
    },
