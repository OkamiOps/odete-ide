    "Crie uma `struct X: View` com `var body: some View`. O preview mostra o subconjunto de SwiftUI na hora; o Playgrounds compila tudo.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Write a `struct X: View` with `var body: some View`. The preview shows the SwiftUI subset right away; Playgrounds compiles everything."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schreib eine `struct X: View` mit `var body: some View`. Das Preview zeigt die SwiftUI-Teilmenge sofort; Playgrounds kompiliert alles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Crée une `struct X: View` avec `var body: some View`. Le Preview montre le sous-ensemble de SwiftUI tout de suite ; le Playgrounds compile tout."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea una `struct X: View` con `var body: some View`. El Preview muestra el subconjunto de SwiftUI al instante; Playgrounds compila todo."
          }
        }
      }
    },
