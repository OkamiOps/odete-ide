    "Isto grava nos arquivos. O desfazer da árvore não cobre troca em massa: confira no git depois.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This writes to the files. The tree's undo doesn't cover bulk replace: check it in git afterwards."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das schreibt in die Dateien. Das Widerrufen im Baum deckt Massenersetzung nicht ab: prüf danach im git."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ça écrit dans les fichiers. L’annulation de l’arborescence ne couvre pas le remplacement en masse : vérifie dans git après."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto escribe en los archivos. El deshacer del árbol no cubre el reemplazo masivo: revísalo en git después."
          }
        }
      }
    },
