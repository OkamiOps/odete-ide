    "Conecte GitHub para clonar e abrir PRs, e uma conta de IA (Claude, Codex, Grok ou chave de API) para o agente.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect GitHub to clone and open PRs, and an AI account (Claude, Codex, Grok or an API key) for the agent."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbinde GitHub zum Klonen und für PRs, und ein KI-Konto (Claude, Codex, Grok oder API-Schlüssel) für den Agent."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connecte GitHub pour cloner et ouvrir des PR, et un compte d’IA (Claude, Codex, Grok ou clé d’API) pour l’agent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecta GitHub para clonar y abrir PRs, y una cuenta de IA (Claude, Codex, Grok o clave de API) para el agente."
          }
        }
      }
    },
