<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- No simulador não há equipe de desenvolvimento, e sem application-identifier o
	     Keychain recusa qualquer gravação com errSecMissingEntitlement (-34018). -->
	<key>application-identifier</key>
	<string>com.okamiops.odete</string>
	<key>get-task-allow</key>
	<true/>
</dict>
</plist>
